{
  "name": "template",
  "version": "0.1.0",
  "description": "Nitro module package",
  "main": "./lib/module/index.js",
  "module": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "react-native": "./lib/module/index.js",
  "source": "src/index",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "clean": "git clean -dfX",
    "release": "semantic-release"
  },
  "keywords": [
    "react-native"
  ],
  "files": [
    "src",
    "react-native.config.js",
    "lib",
    "nitrogen",
    "cpp",
    "nitro.json",
    "android/build.gradle",
    "android/fix-prefab.gradle",
    "android/gradle.properties",
    "android/CMakeLists.txt",
    "android/src",
    "apple/**/*.h",
    "apple/**/*.m",
    "apple/**/*.mm",
    "apple/**/*.cpp",
    "apple/**/*.swift",
    "app.plugin.js",
    "*.podspec",
    "README.md",
    "Package.swift"
  ],
  "workspaces": [
    "example"
  ],
  "repository": "",
  "author": "",
  "license": "MIT",
  "bugs": "",
  "homepage": "",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^11.0.1",
    "@types/jest": "^29.5.12",
    "@types/react": "^19.3.0",
    "nitrogen": "1.0.0-alpha.nightly.84.gc5ad5050ce94",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-builder-bob": "^0.43.0",
    "react-native-nitro-modules": "1.0.0-alpha.nightly.84.gc5ad5050ce94",
    "conventional-changelog-conventionalcommits": "^10.2.1",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "semantic-release": "^25.0.9",
    "typescript": "^6.0.3",
    "nitro-core": "1.0.0-alpha.nightly.84.gc5ad5050ce94"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": ">=0.88.0",
    "react-native-nitro-modules": "^1.0.0-alpha.nightly.84.gc5ad5050ce94",
    "nitro-core": "^1.0.0-alpha.nightly.84.gc5ad5050ce94"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": false,
          "configFile": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.json"
        }
      ]
    ]
  },
  "imports": {
    "#nitro/*": "./nitrogen/generated/shared/javascript/*.cjs"
  },
  "peerDependenciesMeta": {
    "nitro-core": {
      "optional": true
    },
    "react-native-nitro-modules": {
      "optional": true
    }
  }
}
