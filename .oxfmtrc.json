{
    "$schema": "./node_modules/oxfmt/configuration_schema.json",
    "ignorePatterns": [
        "lib/**",
        "node_modules/**",
        "docs/**",
        "assets/template/**",
        "CHANGELOG.md"
    ],
    "printWidth": 80,
    "singleQuote": true,
    "semi": false,
    "trailingComma": "es5",
    "arrowParens": "avoid",
    "sortPackageJson": false,
    "tabWidth": 4
}
